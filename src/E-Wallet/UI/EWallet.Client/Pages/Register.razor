@page "/register"
@using EWallet.Client.Services
@using EWallet.Client.Models.Auth
@using EWallet.Client.Services.Auth

@inject AuthApiClient AuthApiClient
@inject NavigationManager Navigation

<PageTitle>Register</PageTitle>

<div class="ew-auth-wrapper">
    <div class="ew-card p-4 p-md-5">
        <div class="text-center mb-4">
            <div class="ew-icon-box badge-soft-success mx-auto mb-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                    <circle cx="8.5" cy="7" r="4"></circle>
                    <line x1="20" y1="8" x2="20" y2="14"></line>
                    <line x1="23" y1="11" x2="17" y2="11"></line>
                </svg>
            </div>
            <span class="ew-badge badge-soft-success mb-2">Free Digital Wallet</span>
            <h1 class="h3 fw-bold mb-1">Create an account</h1>
            <p class="text-muted small mb-0">Start sending, receiving, and managing funds in minutes</p>
        </div>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger d-flex align-items-center gap-2 rounded-3 py-2 px-3 small" role="alert">
                <span class="ew-badge badge-soft-danger">Error</span>
                <span>@errorMessage</span>
            </div>
        }

        @if (registrationSucceeded)
        {
            <div class="alert alert-success d-flex align-items-center justify-content-between gap-2 rounded-3 py-2 px-3 small" role="status">
                <div>
                    <span class="ew-badge badge-soft-success me-1">Success</span>
                    <span>Registration succeeded.</span>
                </div>
                <a href="/login" class="btn btn-sm btn-success rounded-pill px-3">Go to login</a>
            </div>
        }

        <EditForm Model="@registerRequest" OnValidSubmit="@HandleRegisterAsync">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label" for="userName">Username</label>
                <InputText id="userName" class="form-control" placeholder="johndoe" @bind-Value="registerRequest.UserName" />
                <ValidationMessage For="@(() => registerRequest.UserName)" />
            </div>

            <div class="mb-3">
                <label class="form-label" for="email">Email Address</label>
                <InputText id="email" class="form-control" placeholder="name@example.com" @bind-Value="registerRequest.Email" />
                <ValidationMessage For="@(() => registerRequest.Email)" />
            </div>

            <div class="mb-3">
                <label class="form-label" for="password">Password</label>
                <InputText
                    id="password"
                    type="password"
                    class="form-control"
                    placeholder="••••••••"
                    @bind-Value="registerRequest.Password" />
                <ValidationMessage For="@(() => registerRequest.Password)" />
            </div>

            <div class="mb-4">
                <label class="form-label" for="confirmPassword">Confirm password</label>
                <InputText
                    id="confirmPassword"
                    type="password"
                    class="form-control"
                    placeholder="••••••••"
                    @bind-Value="registerRequest.ConfirmPassword" />
                <ValidationMessage For="@(() => registerRequest.ConfirmPassword)" />
            </div>

            <button type="submit" class="btn btn-ew-primary w-100 py-2" disabled="@isSubmitting">
                @if (isSubmitting)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                }
                @(isSubmitting ? "Registering..." : "Register")
            </button>
        </EditForm>

        <div class="text-center mt-4 pt-3 border-top">
            <span class="text-muted small">Already have an account?</span>
            <a href="/login" class="fw-semibold small ms-1">Login</a>
        </div>
    </div>
</div>

@code {
    private readonly RegisterRequest registerRequest = new();

    private bool isSubmitting;
    private bool registrationSucceeded;
    private string? errorMessage;

    private async Task HandleRegisterAsync()
    {
        isSubmitting = true;
        registrationSucceeded = false;
        errorMessage = null;

        try
        {
            await AuthApiClient.RegisterAsync(registerRequest);
            registrationSucceeded = true;
        }
        catch (ApiException exception)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }
}