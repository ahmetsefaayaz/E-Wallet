@page "/login"

@inject NavigationManager Navigation
@using EWallet.Client.Models.Auth
@using EWallet.Client.Services.Auth
@using EWallet.Client.Services
@using EWallet.Client.Services.Auth
@inject AuthApiClient AuthApiClient
@inject TokenStorage TokenStorage
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Login</PageTitle>

<div class="ew-auth-wrapper">
    <div class="ew-card p-4 p-md-5">
        <div class="text-center mb-4">
            <div class="ew-icon-box badge-soft-primary mx-auto mb-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
            </div>
            <span class="ew-badge badge-soft-primary mb-2">Secure Access</span>
            <h1 class="h3 fw-bold mb-1">Welcome Back</h1>
            <p class="text-muted small mb-0">Sign in to manage your digital wallet &amp; cards</p>
        </div>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger d-flex align-items-center gap-2 rounded-3 py-2 px-3 small" role="alert">
                <span class="ew-badge badge-soft-danger">Error</span>
                <span>@errorMessage</span>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(token))
        {
            <div class="alert alert-success d-flex align-items-center gap-2 rounded-3 py-2 px-3 small">
                <span class="ew-badge badge-soft-success">Authenticated</span>
                <span>Login succeeded. Redirecting...</span>
            </div>
        }

        <EditForm Model="@loginRequest" OnValidSubmit="@HandleLoginAsync">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label" for="email">Email Address</label>
                <InputText id="email" class="form-control" placeholder="name@example.com" @bind-Value="loginRequest.Email" />
                <ValidationMessage For="@(() => loginRequest.Email)" />
            </div>

            <div class="mb-4">
                <label class="form-label" for="password">Password</label>
                <InputText id="password" type="password" class="form-control" placeholder="••••••••" @bind-Value="loginRequest.Password" />
                <ValidationMessage For="@(() => loginRequest.Password)" />
            </div>

            <button type="submit" class="btn btn-ew-primary w-100 py-2" disabled="@isSubmitting">
                @if (isSubmitting)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                }
                @(isSubmitting ? "Logging in..." : "Login")
            </button>
        </EditForm>

        <div class="text-center mt-4 pt-3 border-top">
            <span class="text-muted small">Do not have an account?</span>
            <a href="/register" class="fw-semibold small ms-1">Create free wallet</a>
        </div>
    </div>
</div>

@code {
    private readonly LoginRequest loginRequest = new();

    private bool isSubmitting;
    private string? errorMessage;
    private string? token;

    private async Task HandleLoginAsync()
    {
        isSubmitting = true;
        errorMessage = null;
        token = null;

        try
        {
            var response = await AuthApiClient.LoginAsync(loginRequest);
            token = response.Token;
            await TokenStorage.SetTokenAsync(token);
            ((JwtAuthenticationStateProvider)AuthenticationStateProvider)
                .NotifyUserAuthentication(token);
            Navigation.NavigateTo("/");
        }
        catch (ApiException exception)
        {
            errorMessage = exception.Message;
        }
        catch (HttpRequestException)
        {
            errorMessage = "The login request failed. Check the gateway and your credentials.";
        }
        finally
        {
            isSubmitting = false;
        }
    }
    protected override async Task OnInitializedAsync()
    {
        var authenticationState =
            await AuthenticationStateProvider.GetAuthenticationStateAsync();

        if (authenticationState.User.Identity?.IsAuthenticated == true)
        {
            Navigation.NavigateTo("/");
        }
    }
}