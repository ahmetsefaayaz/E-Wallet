@page "/accounts/{AccountId:guid}/cards"
@page "/my-account/{AccountId:guid}/cards"
@attribute [Authorize]

@using EWallet.Client.Models.Accounts
@using EWallet.Client.Services
@using EWallet.Client.Services.Accounts

@inject AccountApiClient AccountApiClient
@inject NavigationManager Navigation

<PageTitle>Cards</PageTitle>

@{
    var maskedAcc = BitConverter.ToUInt16(AccountId.ToByteArray(), 0) % 9000 + 1000;
    var backHref = CardsBasePath.StartsWith("/my-account", StringComparison.OrdinalIgnoreCase)
        ? "/my-account"
        : "/accounts";
}

<div class="ew-page">
    <div class="mb-3">
        <a href="@backHref" class="btn btn-sm btn-ew-light text-decoration-none">
            ← Back to Accounts
        </a>
    </div>

    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="ew-badge badge-soft-primary">Account #@maskedAcc</span>
                <span class="ew-badge badge-soft-success">@cards.Count @(cards.Count == 1 ? "Card" : "Cards")</span>
            </div>
            <h1 class="ew-page-title">Payment Cards</h1>
            <p class="ew-page-subtitle">Manage virtual and physical debit cards linked to this wallet account</p>
        </div>
        <div>
            <a href="@($"{CardsBasePath}/create")" class="btn btn-ew-primary text-white text-decoration-none d-inline-flex align-items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                Create card
            </a>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="ew-card ew-empty-state">
            <div class="spinner-border text-primary mb-3" role="status"></div>
            <p class="text-muted mb-0">Loading cards...</p>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger d-flex align-items-center gap-2 rounded-3" role="alert">
            <span class="ew-badge badge-soft-danger">Error</span>
            <span>@errorMessage</span>
        </div>
    }
    else if (cards.Count == 0)
    {
        <div class="ew-card ew-empty-state">
            <div class="ew-icon-box badge-soft-primary mx-auto mb-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <rect x="2" y="5" width="20" height="14" rx="2"></rect>
                    <line x1="2" y1="10" x2="22" y2="10"></line>
                </svg>
            </div>
            <h5 class="fw-bold">No Cards Linked Yet</h5>
            <p class="text-muted mb-3">No cards were found.</p>
            <a href="@($"{CardsBasePath}/create")" class="btn btn-ew-primary text-white text-decoration-none">Issue First Card</a>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
            @{ var cardIdx = 0; }
            @foreach (var card in cards)
            {
                var themeClass = (cardIdx % 3) switch
                {
                    0 => "ew-bank-card-indigo",
                    1 => "ew-bank-card-emerald",
                    _ => "ew-bank-card-slate"
                };
                cardIdx++;
                var rawNumber = card.CardNumber ?? string.Empty;
                var displayCardNumber = rawNumber.Length >= 4
                    ? $"••••  ••••  ••••  {rawNumber[^4..]}"
                    : (string.IsNullOrWhiteSpace(rawNumber) ? "••••  ••••  ••••  ••••" : rawNumber);

                <div class="col">
                    <div class="ew-card ew-card-hover p-3 h-100 d-flex flex-column justify-content-between">
                        <div>
                            <div class="ew-bank-card @themeClass mb-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="ew-card-chip"></div>
                                    <span class="badge rounded-pill" style="background: rgba(255,255,255,0.18); color: #fff;">
                                        CARD #@cardIdx • ACTIVE
                                    </span>
                                </div>

                                <div class="ew-card-number">@displayCardNumber</div>

                                <div class="d-flex justify-content-between align-items-end">
                                    <div>
                                        <div class="ew-card-meta-label">Card Holder</div>
                                        <div class="ew-card-meta-value text-uppercase">@(string.IsNullOrWhiteSpace(card.CardHolderName) ? "WALLET MEMBER" : card.CardHolderName)</div>
                                    </div>
                                    <div class="d-flex gap-3 text-end">
                                        <div>
                                            <div class="ew-card-meta-label">Expires</div>
                                            <div class="ew-card-meta-value">@card.CardExpiryDate</div>
                                        </div>
                                        <div>
                                            <div class="ew-card-meta-label">CVV</div>
                                            <div class="ew-card-meta-value">@(string.IsNullOrWhiteSpace(card.CardSecurityNumber) ? "•••" : card.CardSecurityNumber)</div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center px-1 mb-3">
                                <span class="ew-badge badge-soft-success">
                                    <span class="ew-badge-dot"></span>
                                    Active Card
                                </span>
                                <span class="text-muted small">Exp: @card.CardExpiryDate</span>
                            </div>
                        </div>

                        <div class="d-flex gap-2 pt-2 border-top">
                            <a href="@($"{CardsBasePath}/{card.Id}/update")"
                               class="btn btn-sm btn-ew-light flex-grow-1 text-decoration-none">
                                Update
                            </a>
                            <a href="@($"/accounts/{AccountId}/cards/{card.Id}/delete")"
                               class="btn btn-sm btn-ew-danger-soft text-decoration-none">
                                Delete
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public Guid AccountId { get; set; }

    private List<Card> cards = [];
    private bool isLoading = true;
    private string? errorMessage;

    private string CardsBasePath =>
        Navigation.Uri.Contains("/my-account/", StringComparison.OrdinalIgnoreCase)
            ? $"/my-account/{AccountId}/cards"
            : $"/accounts/{AccountId}/cards";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var response =
                await AccountApiClient.GetCardsByAccountIdAsync(AccountId);
            cards = response.Cards;
        }
        catch (ApiException exception)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
}
