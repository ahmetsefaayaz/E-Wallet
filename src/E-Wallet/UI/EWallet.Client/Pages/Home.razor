@page "/"

<PageTitle>Home</PageTitle>

<div class="ew-page">
    <AuthorizeView>
        <Authorized>
            <div class="ew-hero-card mb-4">
                <div class="row align-items-center g-4">
                    <div class="col-lg-8">
                        <span class="ew-badge badge-soft-primary mb-3" style="background: rgba(255,255,255,0.14); color: #e0e7ff; border-color: rgba(255,255,255,0.2);">
                            <span class="ew-badge-dot"></span>
                            Active Digital Wallet
                        </span>
                        <h1 class="fw-bold mb-2">Welcome back, @(context.User.Identity?.Name ?? "Valued Member")</h1>
                        <p class="mb-4" style="color: rgba(255,255,255,0.78); max-width: 560px;">
                            Manage your multi-account balances, virtual &amp; physical cards, instant transfers, and real-time security notifications from one unified Fintech hub.
                        </p>
                        <div class="d-flex flex-wrap gap-2">
                            <a href="/my-account" class="btn btn-light fw-semibold px-4 rounded-3 text-dark">
                                View My Accounts
                            </a>
                            <a href="/transaction-requests" class="btn btn-outline-light fw-semibold px-4 rounded-3">
                                Send / Deposit Funds
                            </a>
                        </div>
                    </div>
                    <div class="col-lg-4 d-none d-lg-block">
                        <div class="ew-bank-card ew-bank-card-indigo shadow-lg">
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="ew-card-chip"></div>
                                <span class="badge bg-light text-dark rounded-pill px-3 py-1">E-WALLET PRO</span>
                            </div>
                            <div class="ew-card-number mb-2">••••  ••••  ••••  4096</div>
                            <div class="d-flex justify-content-between align-items-end">
                                <div>
                                    <div class="ew-card-meta-label">Card Holder</div>
                                    <div class="ew-card-meta-value text-uppercase">@(context.User.Identity?.Name ?? "MEMBER")</div>
                                </div>
                                <div class="text-end">
                                    <div class="ew-card-meta-label">Status</div>
                                    <div class="ew-card-meta-value">Verified</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-4 mb-4">
                <div class="col-md-4">
                    <a href="/my-account" class="text-decoration-none">
                        <div class="ew-card ew-card-hover p-4 h-100">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div class="ew-icon-box badge-soft-primary">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <path d="M20 12V8H6a2 2 0 0 1-2-2c0-1.1.9-2 2-2h12v4"></path>
                                        <path d="M4 6v12c0 1.1.9 2 2 2h14v-4"></path>
                                        <path d="M18 12a2 2 0 0 0-2 2c0 1.1.9 2 2 2h4v-4h-4z"></path>
                                    </svg>
                                </div>
                                <span class="ew-badge badge-soft-success">Accounts &amp; Cards</span>
                            </div>
                            <h5 class="fw-bold text-dark mb-1">My Accounts</h5>
                            <p class="text-muted small mb-0">Open instant accounts, inspect balances, manage linked payment cards, and update your billing address.</p>
                        </div>
                    </a>
                </div>

                <div class="col-md-4">
                    <a href="/transaction-requests" class="text-decoration-none">
                        <div class="ew-card ew-card-hover p-4 h-100">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div class="ew-icon-box badge-soft-success">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <polyline points="17 1 21 5 17 9"></polyline>
                                        <path d="M3 11V9a4 4 0 0 1 4-4h14"></path>
                                        <polyline points="7 23 3 19 7 15"></polyline>
                                        <path d="M21 13v2a4 4 0 0 1-4 4H3"></path>
                                    </svg>
                                </div>
                                <span class="ew-badge badge-soft-info">Instant</span>
                            </div>
                            <h5 class="fw-bold text-dark mb-1">Money Operations</h5>
                            <p class="text-muted small mb-0">Deposit funds, withdraw cash, or send instant account-to-account transfers using your linked cards.</p>
                        </div>
                    </a>
                </div>

                <div class="col-md-4">
                    <a href="/my-notifications" class="text-decoration-none">
                        <div class="ew-card ew-card-hover p-4 h-100">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div class="ew-icon-box badge-soft-warning">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                                        <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                                    </svg>
                                </div>
                                <span class="ew-badge badge-soft-purple">Real-Time</span>
                            </div>
                            <h5 class="fw-bold text-dark mb-1">Activity Alerts</h5>
                            <p class="text-muted small mb-0">Stay informed with real-time alerts for deposits, withdrawals, transfers, and newly issued cards.</p>
                        </div>
                    </a>
                </div>
            </div>
        </Authorized>

        <NotAuthorized>
            <div class="ew-hero-card mb-4">
                <div class="row align-items-center g-4 py-2">
                    <div class="col-lg-7">
                        <span class="ew-badge mb-3" style="background: rgba(16, 185, 129, 0.2); color: #6ee7b7; border: 1px solid rgba(16, 185, 129, 0.35);">
                            <span class="ew-badge-dot"></span>
                            Next-Generation Digital Banking
                        </span>
                        <h1 class="display-6 fw-bold mb-3">Smart, Borderless Digital Wallet for Modern Finance</h1>
                        <p class="mb-4" style="color: rgba(255,255,255,0.78); font-size: 1.05rem;">
                            Create instant accounts, issue virtual payment cards, execute deposits &amp; peer transfers in seconds, and track every movement in real time.
                        </p>
                        <div class="d-flex flex-wrap gap-3">
                            <a href="/register" class="btn btn-light fw-bold px-4 py-2 rounded-3 text-dark">
                                Open Free Wallet
                            </a>
                            <a href="/login" class="btn btn-outline-light fw-semibold px-4 py-2 rounded-3">
                                Sign In to Account
                            </a>
                        </div>
                    </div>
                    <div class="col-lg-5">
                        <div class="ew-bank-card ew-bank-card-emerald">
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="ew-card-chip"></div>
                                <span class="ew-badge" style="background: rgba(255,255,255,0.18); color: #fff;">VIRTUAL PLATINUM</span>
                            </div>
                            <div class="ew-card-number">4532  ••••  ••••  8891</div>
                            <div class="d-flex justify-content-between align-items-end">
                                <div>
                                    <div class="ew-card-meta-label">Card Holder</div>
                                    <div class="ew-card-meta-value">E-WALLET DIGITAL</div>
                                </div>
                                <div class="text-end">
                                    <div class="ew-card-meta-label">Expires</div>
                                    <div class="ew-card-meta-value">12/29</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-4">
                <div class="col-md-4">
                    <div class="ew-card p-4 h-100">
                        <span class="ew-badge badge-soft-success mb-3">Instant Issuance</span>
                        <h5 class="fw-bold">Multi-Card Management</h5>
                        <p class="text-muted small mb-0">Link and manage multiple payment cards per wallet account with instant updates and full control.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="ew-card p-4 h-100">
                        <span class="ew-badge badge-soft-primary mb-3">Zero Friction</span>
                        <h5 class="fw-bold">Fast Deposits &amp; Transfers</h5>
                        <p class="text-muted small mb-0">Top up balances, withdraw funds, or transfer seamlessly between accounts in just a few clicks.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="ew-card p-4 h-100">
                        <span class="ew-badge badge-soft-info mb-3">Smart Monitoring</span>
                        <h5 class="fw-bold">Live Activity Notifications</h5>
                        <p class="text-muted small mb-0">Every card event and balance transaction triggers instant notifications so you never miss a beat.</p>
                    </div>
                </div>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</div>
