@page "/my-account"
@attribute [Authorize]

@using EWallet.Client.Models.Accounts
@using EWallet.Client.Models.Identity
@using EWallet.Client.Services
@using EWallet.Client.Services.Accounts
@using EWallet.Client.Services.Identity

@inject AccountApiClient AccountApiClient
@inject IdentityAdministrationApiClient IdentityAdministrationApiClient

<PageTitle>My accounts</PageTitle>

<h1>My accounts</h1>

<button type="button" @onclick="CreateAccountAsync" disabled="@isCreatingAccount">
    @(isCreatingAccount ? "Creating..." : "Create account")
</button>

@if (!string.IsNullOrWhiteSpace(createAccountErrorMessage))
{
    <p role="alert">@createAccountErrorMessage</p>
}

@if (createdAccountId is not null)
{
    <p role="status">Account created: @createdAccountId</p>
}

<p>
    <a href="/address/create">Create address</a>
    <span> | </span>
    <a href="/address/update">Update address</a>
</p>

@if (address is not null)
{
    <h2>My address</h2>
    <dl>
        <dt>Address line</dt>
        <dd>@address.AddressLine</dd>
        <dt>City</dt>
        <dd>@address.City</dd>
        <dt>State</dt>
        <dd>@address.State</dd>
        <dt>Country</dt>
        <dd>@address.Country</dd>
        <dt>Zip code</dt>
        <dd>@address.ZipCode</dd>
    </dl>
}
else if (!string.IsNullOrWhiteSpace(addressErrorMessage))
{
    <p role="alert">@addressErrorMessage</p>
}
else if (!isLoadingAddress && string.IsNullOrWhiteSpace(addressErrorMessage))
{
    <p>No address has been added yet.</p>
}

@if (isLoading)
{
    <p>Loading your accounts...</p>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <p role="alert">@errorMessage</p>
}
else if (accounts.Count == 0)
{
    <p>No accounts were found for the signed-in user.</p>
}
else
{
    <ul>
        @foreach (var account in accounts)
        {
            <li>
                <strong>Account: @account.Id</strong>
                <span>Balance: @account.AccountBalance</span>
                <a href="@($"/my-account/{account.Id}/transactions")">
                    Transactions
                </a>
                <a href="@($"/my-account/{account.Id}/cards")">
                    Cards
                </a>
            </li>
        }
    </ul>
}

@code {
    private List<Account> accounts = [];
    private AddressDto? address;
    private bool isLoading = true;
    private bool isLoadingAddress = true;
    private bool isCreatingAccount;
    private Guid? createdAccountId;
    private string? errorMessage;
    private string? addressErrorMessage;
    private string? createAccountErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadAccountsAsync(), LoadAddressAsync());
    }

    private async Task LoadAccountsAsync()
    {
        try
        {
            var response = await AccountApiClient.GetMyAccountsAsync();
            accounts = response.Accounts;
        }
        catch (ApiException exception)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadAddressAsync()
    {
        try
        {
            var response =
                await IdentityAdministrationApiClient.GetMyAddressAsync();
            address = response.Address;
        }
        catch (ApiException exception)
        {
            addressErrorMessage = exception.Message;
        }
        finally
        {
            isLoadingAddress = false;
        }
    }

    private async Task CreateAccountAsync()
    {
        isCreatingAccount = true;
        createdAccountId = null;
        createAccountErrorMessage = null;

        try
        {
            var response = await AccountApiClient.CreateAccountAsync();
            createdAccountId = response.AccountId;

            var accountsResponse = await AccountApiClient.GetMyAccountsAsync();
            accounts = accountsResponse.Accounts;
        }
        catch (ApiException exception)
        {
            createAccountErrorMessage = exception.Message;
        }
        finally
        {
            isCreatingAccount = false;
        }
    }
}
