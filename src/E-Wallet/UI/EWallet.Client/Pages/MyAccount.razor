@page "/my-account"
@attribute [Authorize]

@using System.Security.Claims
@using EWallet.Client.Models.Accounts
@using EWallet.Client.Services
@using EWallet.Client.Services.Accounts

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject AccountApiClient AccountApiClient

<PageTitle>My account</PageTitle>

<h1>My account</h1>

@if (isLoading)
{
    <p>Loading your account...</p>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <p role="alert">@errorMessage</p>
}
else if (account is null)
{
    <p>No account was found for the signed-in user.</p>
}
else
{
    <dl>
        <dt>Account ID</dt>
        <dd>@account.Id</dd>
        <dt>User ID</dt>
        <dd>@account.UserId</dd>
        <dt>Balance</dt>
        <dd>@account.AccountBalance</dd>
    </dl>
}

@code {
    private Account? account;
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authenticationState =
                await AuthenticationStateProvider.GetAuthenticationStateAsync();

            var userIdValue =
                authenticationState.User.FindFirst(
                    ClaimTypes.NameIdentifier)?.Value;

            if (!Guid.TryParse(userIdValue, out var userId))
            {
                errorMessage =
                    "The signed-in user ID was not found in the access token.";
                return;
            }

            var accountsResponse =
                await AccountApiClient.GetAccountsAsync();

            var userAccount = accountsResponse.PaginatedResult?.Data
                .FirstOrDefault(candidate => candidate.UserId == userId);

            if (userAccount is null)
            {
                return;
            }

            var accountResponse =
                await AccountApiClient.GetAccountByIdAsync(userAccount.Id);

            account = accountResponse.Account;
        }
        catch (ApiException exception)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
}
