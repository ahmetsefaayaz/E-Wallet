@page "/accounts/{AccountId:guid}/cards/{CardId:guid}/delete"
@attribute [Authorize(Policy = "AccountDepartment")]

@using EWallet.Client.Services
@using EWallet.Client.Services.Accounts

@inject AccountApiClient AccountApiClient
@inject NavigationManager Navigation

<PageTitle>Delete card</PageTitle>

@{
    var maskedCard = BitConverter.ToUInt16(CardId.ToByteArray(), 0) % 9000 + 1000;
    var maskedAccount = BitConverter.ToUInt16(AccountId.ToByteArray(), 0) % 9000 + 1000;
}

<div class="ew-page-narrow py-3">
    <div class="ew-card p-4 p-md-5 text-center">
        <div class="ew-icon-box badge-soft-danger mx-auto mb-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <rect x="2" y="5" width="20" height="14" rx="2"></rect>
                <line x1="2" y1="10" x2="22" y2="10"></line>
            </svg>
        </div>

        <span class="ew-badge badge-soft-danger mb-2">Card Revocation</span>
        <h1 class="h3 fw-bold mb-2">Delete card</h1>
        <p class="text-muted mb-4">
            Are you sure you want to permanently remove <strong>Card #@maskedCard</strong> from <strong>Account #@maskedAccount</strong>?
        </p>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger d-flex align-items-center justify-content-center gap-2 rounded-3 mb-4 small" role="alert">
                <span class="ew-badge badge-soft-danger">Error</span>
                <span>@errorMessage</span>
            </div>
        }

        <div class="d-flex justify-content-center gap-2">
            <a href="@($"/accounts/{AccountId}/cards")" class="btn btn-ew-light px-4 text-decoration-none">Cancel</a>
            <button type="button" class="btn btn-danger px-4 rounded-3 fw-semibold" @onclick="DeleteAsync" disabled="@isSubmitting">
                @if (isSubmitting)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                }
                @(isSubmitting ? "Deleting..." : "Delete card")
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public Guid AccountId { get; set; }
    [Parameter] public Guid CardId { get; set; }

    private bool isSubmitting;
    private string? errorMessage;

    private async Task DeleteAsync()
    {
        isSubmitting = true;
        errorMessage = null;

        try
        {
            var response = await AccountApiClient.DeleteCardAsync(
                AccountId,
                CardId);

            if (response.IsSuccess)
            {
                Navigation.NavigateTo($"/accounts/{AccountId}/cards");
            }
            else
            {
                errorMessage = "The card could not be deleted.";
            }
        }
        catch (ApiException exception)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
