@page "/my-cards"
@attribute [Authorize]

@using System.Security.Claims
@using EWallet.Client.Models.Accounts
@using EWallet.Client.Services
@using EWallet.Client.Services.Accounts

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject AccountApiClient AccountApiClient

<PageTitle>My cards</PageTitle>

<h1>My cards</h1>

@if (isLoading)
{
    <p>Loading your cards...</p>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <p role="alert">@errorMessage</p>
}
else if (cards.Count == 0)
{
    <p>No cards were found for your account.</p>
}
else
{
    <ul>
        @foreach (var card in cards)
        {
            <li>
                <strong>@card.CardHolderName</strong>
                <span>@card.CardNumber</span>
                <span>Expires: @card.CardExpiryDate</span>
            </li>
        }
    </ul>
}

@code {
    private List<Card> cards = [];
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var state =
                await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var userIdValue =
                state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

            if (!Guid.TryParse(userIdValue, out var userId))
            {
                errorMessage =
                    "The signed-in user ID was not found in the access token.";
                return;
            }

            var accounts = await AccountApiClient.GetAccountsAsync();
            var account = accounts.PaginatedResult?.Data
                .FirstOrDefault(candidate => candidate.UserId == userId);

            if (account is null)
            {
                return;
            }

            var response =
                await AccountApiClient.GetCardsByAccountIdAsync(account.Id);
            cards = response.Cards;
        }
        catch (ApiException exception)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
}
