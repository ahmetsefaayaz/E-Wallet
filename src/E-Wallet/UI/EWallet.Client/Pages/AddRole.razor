@page "/users/{UserId:guid}/roles/add"
@attribute [Authorize(Policy = "IdentityDepartment")]

@using System.ComponentModel.DataAnnotations
@using EWallet.Client.Models.Identity
@using EWallet.Client.Services
@using EWallet.Client.Services.Identity

@inject IdentityAdministrationApiClient IdentityAdministrationApiClient

<PageTitle>Add role</PageTitle>

<h1>Add role to user</h1>

<p>User ID: @UserId</p>

<EditForm Model="@request" OnValidSubmit="@HandleSubmitAsync">
    <DataAnnotationsValidator />

    <div>
        <label for="roleName">Role name</label>
        <InputText id="roleName" @bind-Value="request.RoleName" />
        <ValidationMessage For="@(() => request.RoleName)" />
    </div>

    <button type="submit" disabled="@isSubmitting">
        @(isSubmitting ? "Adding..." : "Add role")
    </button>
</EditForm>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <p role="alert">@errorMessage</p>
}

@if (isSuccess)
{
    <p role="status">Role added successfully.</p>
}

@code {
    [Parameter]
    public Guid UserId { get; set; }

    private readonly AddRoleForm request = new();
    private bool isSubmitting;
    private bool isSuccess;
    private string? errorMessage;

    private async Task HandleSubmitAsync()
    {
        isSubmitting = true;
        isSuccess = false;
        errorMessage = null;

        try
        {
            var response =
                await IdentityAdministrationApiClient.AddRoleAsync(
                    UserId,
                    new AddRoleRequest
                    {
                        RoleName = request.RoleName
                    });

            isSuccess = response.IsSuccess;
        }
        catch (ApiException exception)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private sealed class AddRoleForm
    {
        [Required]
        public string RoleName { get; set; } = string.Empty;
    }
}
