@page "/users/{UserId:guid}/roles/add"
@attribute [Authorize(Policy = "IdentityDepartment")]

@using System.ComponentModel.DataAnnotations
@using EWallet.Client.Models.Identity
@using EWallet.Client.Services
@using EWallet.Client.Services.Identity

@inject IdentityAdministrationApiClient IdentityAdministrationApiClient

<PageTitle>Add role</PageTitle>

@{
    var maskedUser = BitConverter.ToUInt16(UserId.ToByteArray(), 0) % 9000 + 1000;
}

<div class="ew-page-narrow">
    <div class="mb-3">
        <a href="/users" class="btn btn-sm btn-ew-light text-decoration-none">
            ← Back to Users
        </a>
    </div>

    <div class="ew-card p-4 p-md-5">
        <div class="mb-4">
            <span class="ew-badge badge-soft-purple mb-2">Member #@maskedUser</span>
            <h1 class="ew-page-title h3">Add role to user</h1>
            <p class="ew-page-subtitle">Grant an existing security role to Member #@maskedUser</p>
        </div>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger d-flex align-items-center gap-2 rounded-3 mb-4 small" role="alert">
                <span class="ew-badge badge-soft-danger">Error</span>
                <span>@errorMessage</span>
            </div>
        }

        @if (isSuccess)
        {
            <div class="alert alert-success d-flex align-items-center justify-content-between gap-2 rounded-3 mb-4 small" role="status">
                <div>
                    <span class="ew-badge badge-soft-success me-1">Assigned</span>
                    <span>Role added successfully.</span>
                </div>
                <a href="@($"/users/{UserId}/roles")" class="btn btn-sm btn-success rounded-pill px-3">View Roles</a>
            </div>
        }

        <EditForm Model="@request" OnValidSubmit="@HandleSubmitAsync">
            <DataAnnotationsValidator />

            <div class="mb-4">
                <label class="form-label" for="roleName">Role name</label>
                <InputText id="roleName" class="form-control" placeholder="e.g. Admin" @bind-Value="request.RoleName" />
                <ValidationMessage For="@(() => request.RoleName)" />
            </div>

            <button type="submit" class="btn btn-ew-primary px-4 py-2" disabled="@isSubmitting">
                @if (isSubmitting)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                }
                @(isSubmitting ? "Adding..." : "Add role")
            </button>
        </EditForm>
    </div>
</div>

@code {
    [Parameter]
    public Guid UserId { get; set; }

    private readonly AddRoleForm request = new();
    private bool isSubmitting;
    private bool isSuccess;
    private string? errorMessage;

    private async Task HandleSubmitAsync()
    {
        isSubmitting = true;
        isSuccess = false;
        errorMessage = null;

        try
        {
            var response =
                await IdentityAdministrationApiClient.AddRoleAsync(
                    UserId,
                    new AddRoleRequest
                    {
                        RoleName = request.RoleName
                    });

            isSuccess = response.IsSuccess;
        }
        catch (ApiException exception)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private sealed class AddRoleForm
    {
        [Required]
        public string RoleName { get; set; } = string.Empty;
    }
}
