{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Database": "Server=localhost;Port=5434;Database=AccountDb;Username=YOUR_DB_NAME;Password=YOUR_DB_PASSWORD;"
  },
  "MessageBroker": {
    "Host": "amqp://localhost:5672",
    "UserName": "YOUR_RABBITMQ_USERNAME",
    "Password": "YOUR_RABBITMQ_PASSWORD"
  },
  "Jwt": {
    "Key": "YOUR_JWT_TOKEN",
    "Issuer": "dotnet-user-jwts",
    "Audiences": [
      "https://localhost:5050",
      "https://localhost:5051",
      "https://localhost:5052"
    ]
  }
}
