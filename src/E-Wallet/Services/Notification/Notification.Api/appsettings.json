{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MessageBroker": {
    "Host": "amqp://localhost:5672",
    "UserName": "YOUR_RABBITMQ_USERNAME",
    "Password": "YOUR_RABBITMQ_PASSWORD"
  },
  "ConnectionStrings": {
    "MongoDb": "mongodb://localhost:27017"
  },
  "DatabaseSettings": {
    "NotificationDbName": "NotificationDb",
    "UserDbName": "UserDb"
  },
  "SmtpSettings": {
    "Host":"localhost",
    "Port": 1025
  },
  "Jwt": {
    "Key": "YOUR_JWT_TOKEN",
    "Issuer": "dotnet-user-jwts",
    "Audiences": [
      "https://localhost:5050",
      "https://localhost:5051",
      "https://localhost:5052"
    ]
  }
}